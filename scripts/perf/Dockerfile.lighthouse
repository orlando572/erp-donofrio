# HU-28: Lighthouse CLI con Chromium, para medir WPO (antes/después) sin instalar nada en el PC.
# Se construye solo desde scripts/perf/lighthouse.sh.
FROM node:22-bookworm-slim
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends chromium fonts-dejavu-core ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g --silent lighthouse@12.2.1
ENV CHROME_PATH=/usr/bin/chromium
