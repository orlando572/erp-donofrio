entity "product_product" as product_product #EAF5E4 {
  * id : integer <<PK>>
  --
  default_code : varchar
  barcode : varchar
  active : boolean
}
entity "product_supplierinfo" as product_supplierinfo #EAF5E4 {
  * id : integer <<PK>>
  --
  * partner_id : integer <<FK>>
  product_id : integer <<FK>>
  * delay : integer
  * min_qty : numeric
  price : numeric
}
entity "stock_warehouse_orderpoint" as stock_warehouse_orderpoint #FFF1D6 {
  * id : integer <<PK>>
  --
  * product_id : integer <<FK>>
  bom_id : integer <<FK>>
  supplier_id : integer <<FK>>
  * trigger : varchar
  * product_min_qty : numeric
  * product_max_qty : numeric
}
entity "mrp_bom" as mrp_bom #F6E3F4 {
  * id : integer <<PK>>
  --
  product_id : integer <<FK>>
  code : varchar
  * type : varchar
  * product_qty : numeric
}
entity "mrp_bom_line" as mrp_bom_line #F6E3F4 {
  * id : integer <<PK>>
  --
  * product_id : integer <<FK>>
  * bom_id : integer <<FK>>
  operation_id : integer <<FK>>
  * product_qty : numeric
}
entity "mrp_routing_workcenter" as mrp_routing_workcenter #F6E3F4 {
  * id : integer <<PK>>
  --
  * workcenter_id : integer <<FK>>
  * bom_id : integer <<FK>>
  * name : varchar
  time_cycle_manual : double precision
}
entity "mrp_workcenter" as mrp_workcenter #F6E3F4 {
  * id : integer <<PK>>
  --
  name : varchar
  costs_hour : double precision
}
entity "mrp_production" as mrp_production #F6E3F4 {
  * id : integer <<PK>>
  --
  * product_id : integer <<FK>>
  bom_id : integer <<FK>>
  orderpoint_id : integer <<FK>>
  name : varchar
  origin : varchar
  state : varchar
  * product_qty : numeric
  * date_start : timestamp
  date_finished : timestamp
}
entity "mrp_workorder" as mrp_workorder #F6E3F4 {
  * id : integer <<PK>>
  --
  * workcenter_id : integer <<FK>>
  * production_id : integer <<FK>>
  operation_id : integer <<FK>>
  * name : varchar
  state : varchar
  duration_expected : numeric
}
entity "stock_lot" as stock_lot #FFF1D6 {
  * id : integer <<PK>>
  --
  * product_id : integer <<FK>>
  * name : varchar
  expiration_date : timestamp
  use_date : timestamp
  removal_date : timestamp
  alert_date : timestamp
}
entity "stock_move" as stock_move #FFF1D6 {
  * id : integer <<PK>>
  --
  * product_id : integer <<FK>>
  partner_id : integer <<FK>>
  restrict_partner_id : integer <<FK>>
  orderpoint_id : integer <<FK>>
  created_production_id : integer <<FK>>
  production_id : integer <<FK>>
  operation_id : integer <<FK>>
  workorder_id : integer <<FK>>
  bom_line_id : integer <<FK>>
  purchase_line_id : integer <<FK>>
  <i>+ FK a stock_move, mrp_production</i>
  state : varchar
  origin : varchar
  * product_uom_qty : numeric
  quantity : numeric
  * date : timestamp
}
entity "purchase_order" as purchase_order #FBE5DC {
  * id : integer <<PK>>
  --
  * partner_id : integer <<FK>>
  dest_address_id : integer <<FK>>
  * name : varchar
  state : varchar
  amount_total : numeric
  * date_order : timestamp
}
entity "purchase_order_line" as purchase_order_line #FBE5DC {
  * id : integer <<PK>>
  --
  product_id : integer <<FK>>
  * order_id : integer <<FK>>
  partner_id : integer <<FK>>
  orderpoint_id : integer <<FK>>
  * product_qty : numeric
  * price_unit : numeric
  qty_received : numeric
}
entity "res_partner" as res_partner #EAF5E4 {
  * id : integer <<PK>>
  --
  <i>+ FK a res_partner ×2</i>
  name : varchar
  vat : varchar
  active : boolean
}
