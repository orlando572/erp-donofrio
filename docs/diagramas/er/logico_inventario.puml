stock_picking }o--|| stock_picking_type : picking_type_id
stock_picking }o--o| res_partner : partner_id, owner_id
stock_move }o--|| product_product : product_id
stock_move }o--|| stock_location : location_id, location_dest_id (+1)
stock_move }o--o| res_partner : partner_id, restrict_partner_id
stock_move }o--o| stock_picking : picking_id
stock_move }o--o| stock_picking_type : picking_type_id
