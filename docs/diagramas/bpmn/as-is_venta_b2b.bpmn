<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="def_as_is_venta_b2b" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="colab_as_is_venta_b2b">
    <bpmn:participant id="pool_as_is_venta_b2b" name="AS-IS · Venta a cliente B2B (autoservicio o distribuidor)" processRef="proc_as_is_venta_b2b" />
  </bpmn:collaboration>
  <bpmn:process id="proc_as_is_venta_b2b" isExecutable="false">
    <bpmn:laneSet id="carriles">
      <bpmn:lane id="carril_0" name="Cliente">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recibe</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_1" name="Vendedor">
        <bpmn:flowNodeRef>anota</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>especial</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_2" name="Jefe de Ventas">
        <bpmn:flowNodeRef>aprueba</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_3" name="Facturación">
        <bpmn:flowNodeRef>factura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cobra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_4" name="Almacén">
        <bpmn:flowNodeRef>prepara</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>entrega</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Necesita reponer productos">
      <bpmn:outgoing>flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="pedido" name="Envía el pedido por correo o teléfono">
      <bpmn:incoming>flujo_1</bpmn:incoming>
      <bpmn:outgoing>flujo_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="anota" name="Anota el pedido en Excel y calcula el precio">
      <bpmn:incoming>flujo_2</bpmn:incoming>
      <bpmn:outgoing>flujo_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="especial" name="¿Pide descuento o crédito?">
      <bpmn:incoming>flujo_3</bpmn:incoming>
      <bpmn:outgoing>flujo_4</bpmn:outgoing>
      <bpmn:outgoing>flujo_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="aprueba" name="Aprueba por correo, sin registro">
      <bpmn:incoming>flujo_4</bpmn:incoming>
      <bpmn:outgoing>flujo_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="factura" name="Vuelve a digitar el pedido y emite la factura">
      <bpmn:incoming>flujo_5</bpmn:incoming>
      <bpmn:incoming>flujo_6</bpmn:incoming>
      <bpmn:outgoing>flujo_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="prepara" name="Prepara el despacho con hoja impresa, sin ver vencimientos">
      <bpmn:incoming>flujo_7</bpmn:incoming>
      <bpmn:outgoing>flujo_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="entrega" name="Entrega con guía de remisión en papel">
      <bpmn:incoming>flujo_8</bpmn:incoming>
      <bpmn:outgoing>flujo_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="recibe" name="Recibe y firma la guía">
      <bpmn:incoming>flujo_9</bpmn:incoming>
      <bpmn:outgoing>flujo_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="cobra" name="Cobra y concilia a fin de mes en Excel">
      <bpmn:incoming>flujo_10</bpmn:incoming>
      <bpmn:outgoing>flujo_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Pedido cerrado">
      <bpmn:incoming>flujo_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flujo_1" sourceRef="inicio" targetRef="pedido" />
    <bpmn:sequenceFlow id="flujo_2" sourceRef="pedido" targetRef="anota" />
    <bpmn:sequenceFlow id="flujo_3" sourceRef="anota" targetRef="especial" />
    <bpmn:sequenceFlow id="flujo_4" name="Sí" sourceRef="especial" targetRef="aprueba" />
    <bpmn:sequenceFlow id="flujo_5" name="No" sourceRef="especial" targetRef="factura" />
    <bpmn:sequenceFlow id="flujo_6" sourceRef="aprueba" targetRef="factura" />
    <bpmn:sequenceFlow id="flujo_7" sourceRef="factura" targetRef="prepara" />
    <bpmn:sequenceFlow id="flujo_8" sourceRef="prepara" targetRef="entrega" />
    <bpmn:sequenceFlow id="flujo_9" sourceRef="entrega" targetRef="recibe" />
    <bpmn:sequenceFlow id="flujo_10" sourceRef="recibe" targetRef="cobra" />
    <bpmn:sequenceFlow id="flujo_11" sourceRef="cobra" targetRef="fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama">
    <bpmndi:BPMNPlane id="plano" bpmnElement="colab_as_is_venta_b2b">
      <bpmndi:BPMNShape id="pool_as_is_venta_b2b_di" bpmnElement="pool_as_is_venta_b2b" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1745" height="750" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_0_di" bpmnElement="carril_0" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1715" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_1_di" bpmnElement="carril_1" isHorizontal="true">
        <dc:Bounds x="50" y="170" width="1715" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_2_di" bpmnElement="carril_2" isHorizontal="true">
        <dc:Bounds x="50" y="320" width="1715" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_3_di" bpmnElement="carril_3" isHorizontal="true">
        <dc:Bounds x="50" y="470" width="1715" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_4_di" bpmnElement="carril_4" isHorizontal="true">
        <dc:Bounds x="50" y="620" width="1715" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inicio_di" bpmnElement="inicio">
        <dc:Bounds x="146" y="77" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="104" y="117" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pedido_di" bpmnElement="pedido">
        <dc:Bounds x="255" y="58" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="anota_di" bpmnElement="anota" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="405" y="208" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="especial_di" bpmnElement="especial" isMarkerVisible="true">
        <dc:Bounds x="589" y="220" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="554" y="186" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="aprueba_di" bpmnElement="aprueba" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="705" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="factura_di" bpmnElement="factura" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="855" y="508" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="prepara_di" bpmnElement="prepara" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="1005" y="658" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="entrega_di" bpmnElement="entrega">
        <dc:Bounds x="1155" y="658" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="recibe_di" bpmnElement="recibe">
        <dc:Bounds x="1305" y="58" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cobra_di" bpmnElement="cobra" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="1455" y="508" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_di" bpmnElement="fin">
        <dc:Bounds x="1646" y="527" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1604" y="567" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flujo_1_di" bpmnElement="flujo_1">
        <di:waypoint x="182" y="95" />
        <di:waypoint x="255" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_2_di" bpmnElement="flujo_2">
        <di:waypoint x="373" y="95" />
        <di:waypoint x="389" y="95" />
        <di:waypoint x="389" y="245" />
        <di:waypoint x="405" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_3_di" bpmnElement="flujo_3">
        <di:waypoint x="523" y="245" />
        <di:waypoint x="589" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_4_di" bpmnElement="flujo_4">
        <di:waypoint x="614" y="270" />
        <di:waypoint x="614" y="395" />
        <di:waypoint x="705" y="395" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="620" y="274" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_5_di" bpmnElement="flujo_5">
        <di:waypoint x="639" y="245" />
        <di:waypoint x="839" y="245" />
        <di:waypoint x="839" y="545" />
        <di:waypoint x="855" y="545" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="645" y="225" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_6_di" bpmnElement="flujo_6">
        <di:waypoint x="823" y="395" />
        <di:waypoint x="839" y="395" />
        <di:waypoint x="839" y="545" />
        <di:waypoint x="855" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_7_di" bpmnElement="flujo_7">
        <di:waypoint x="973" y="545" />
        <di:waypoint x="989" y="545" />
        <di:waypoint x="989" y="695" />
        <di:waypoint x="1005" y="695" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_8_di" bpmnElement="flujo_8">
        <di:waypoint x="1123" y="695" />
        <di:waypoint x="1155" y="695" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_9_di" bpmnElement="flujo_9">
        <di:waypoint x="1273" y="695" />
        <di:waypoint x="1289" y="695" />
        <di:waypoint x="1289" y="95" />
        <di:waypoint x="1305" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_10_di" bpmnElement="flujo_10">
        <di:waypoint x="1423" y="95" />
        <di:waypoint x="1439" y="95" />
        <di:waypoint x="1439" y="545" />
        <di:waypoint x="1455" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_11_di" bpmnElement="flujo_11">
        <di:waypoint x="1573" y="545" />
        <di:waypoint x="1646" y="545" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
