<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="def_as_is_liquidacion_heladero" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="colab_as_is_liquidacion_heladero">
    <bpmn:participant id="pool_as_is_liquidacion_heladero" name="AS-IS · Liquidación diaria del heladero" processRef="proc_as_is_liquidacion_heladero" />
  </bpmn:collaboration>
  <bpmn:process id="proc_as_is_liquidacion_heladero" isExecutable="false">
    <bpmn:laneSet id="carriles">
      <bpmn:lane id="carril_0" name="Heladero">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ruta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>vuelve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_1" name="Despachador">
        <bpmn:flowNodeRef>entrega</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_2" name="Liquidador">
        <bpmn:flowNodeRef>cuenta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cuadra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cuaderno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>excel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_3" name="Caja">
        <bpmn:flowNodeRef>deposita</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Inicio de la jornada">
      <bpmn:outgoing>flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="pide" name="Pide su carga de helados del día">
      <bpmn:incoming>flujo_1</bpmn:incoming>
      <bpmn:outgoing>flujo_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="entrega" name="Entrega los helados y anota en el cuaderno">
      <bpmn:incoming>flujo_2</bpmn:incoming>
      <bpmn:outgoing>flujo_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ruta" name="Sale a la ruta y vende">
      <bpmn:incoming>flujo_3</bpmn:incoming>
      <bpmn:outgoing>flujo_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="vuelve" name="Regresa y entrega el sobrante y el efectivo">
      <bpmn:incoming>flujo_4</bpmn:incoming>
      <bpmn:outgoing>flujo_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="cuenta" name="Cuenta lo devuelto y calcula lo vendido a mano">
      <bpmn:incoming>flujo_5</bpmn:incoming>
      <bpmn:outgoing>flujo_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="cuadra" name="¿El efectivo cuadra?">
      <bpmn:incoming>flujo_6</bpmn:incoming>
      <bpmn:outgoing>flujo_7</bpmn:outgoing>
      <bpmn:outgoing>flujo_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="cuaderno" name="Anota el descuadre y lo descuenta al día siguiente">
      <bpmn:incoming>flujo_7</bpmn:incoming>
      <bpmn:outgoing>flujo_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="deposita" name="Recibe el efectivo y emite recibo">
      <bpmn:incoming>flujo_8</bpmn:incoming>
      <bpmn:incoming>flujo_9</bpmn:incoming>
      <bpmn:outgoing>flujo_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="excel" name="Pasa la liquidación a Excel al cierre">
      <bpmn:incoming>flujo_10</bpmn:incoming>
      <bpmn:outgoing>flujo_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Liquidación cerrada">
      <bpmn:incoming>flujo_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flujo_1" sourceRef="inicio" targetRef="pide" />
    <bpmn:sequenceFlow id="flujo_2" sourceRef="pide" targetRef="entrega" />
    <bpmn:sequenceFlow id="flujo_3" sourceRef="entrega" targetRef="ruta" />
    <bpmn:sequenceFlow id="flujo_4" sourceRef="ruta" targetRef="vuelve" />
    <bpmn:sequenceFlow id="flujo_5" sourceRef="vuelve" targetRef="cuenta" />
    <bpmn:sequenceFlow id="flujo_6" sourceRef="cuenta" targetRef="cuadra" />
    <bpmn:sequenceFlow id="flujo_7" name="No" sourceRef="cuadra" targetRef="cuaderno" />
    <bpmn:sequenceFlow id="flujo_8" name="Sí" sourceRef="cuadra" targetRef="deposita" />
    <bpmn:sequenceFlow id="flujo_9" sourceRef="cuaderno" targetRef="deposita" />
    <bpmn:sequenceFlow id="flujo_10" sourceRef="deposita" targetRef="excel" />
    <bpmn:sequenceFlow id="flujo_11" sourceRef="excel" targetRef="fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama">
    <bpmndi:BPMNPlane id="plano" bpmnElement="colab_as_is_liquidacion_heladero">
      <bpmndi:BPMNShape id="pool_as_is_liquidacion_heladero_di" bpmnElement="pool_as_is_liquidacion_heladero" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1595" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_0_di" bpmnElement="carril_0" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_1_di" bpmnElement="carril_1" isHorizontal="true">
        <dc:Bounds x="50" y="170" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_2_di" bpmnElement="carril_2" isHorizontal="true">
        <dc:Bounds x="50" y="320" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_3_di" bpmnElement="carril_3" isHorizontal="true">
        <dc:Bounds x="50" y="470" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inicio_di" bpmnElement="inicio">
        <dc:Bounds x="146" y="77" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="104" y="117" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pide_di" bpmnElement="pide">
        <dc:Bounds x="255" y="58" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="entrega_di" bpmnElement="entrega" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="405" y="208" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ruta_di" bpmnElement="ruta">
        <dc:Bounds x="555" y="58" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="vuelve_di" bpmnElement="vuelve">
        <dc:Bounds x="705" y="58" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cuenta_di" bpmnElement="cuenta" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="855" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cuadra_di" bpmnElement="cuadra" isMarkerVisible="true">
        <dc:Bounds x="1039" y="370" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1004" y="336" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cuaderno_di" bpmnElement="cuaderno" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="1155" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="deposita_di" bpmnElement="deposita">
        <dc:Bounds x="1155" y="508" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="excel_di" bpmnElement="excel" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="1305" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_di" bpmnElement="fin">
        <dc:Bounds x="1496" y="377" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1454" y="417" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flujo_1_di" bpmnElement="flujo_1">
        <di:waypoint x="182" y="95" />
        <di:waypoint x="255" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_2_di" bpmnElement="flujo_2">
        <di:waypoint x="373" y="95" />
        <di:waypoint x="389" y="95" />
        <di:waypoint x="389" y="245" />
        <di:waypoint x="405" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_3_di" bpmnElement="flujo_3">
        <di:waypoint x="523" y="245" />
        <di:waypoint x="539" y="245" />
        <di:waypoint x="539" y="95" />
        <di:waypoint x="555" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_4_di" bpmnElement="flujo_4">
        <di:waypoint x="673" y="95" />
        <di:waypoint x="705" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_5_di" bpmnElement="flujo_5">
        <di:waypoint x="823" y="95" />
        <di:waypoint x="839" y="95" />
        <di:waypoint x="839" y="395" />
        <di:waypoint x="855" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_6_di" bpmnElement="flujo_6">
        <di:waypoint x="973" y="395" />
        <di:waypoint x="1039" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_7_di" bpmnElement="flujo_7">
        <di:waypoint x="1089" y="395" />
        <di:waypoint x="1155" y="395" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1095" y="375" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_8_di" bpmnElement="flujo_8">
        <di:waypoint x="1064" y="420" />
        <di:waypoint x="1064" y="545" />
        <di:waypoint x="1155" y="545" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1070" y="424" width="22" height="14" />
