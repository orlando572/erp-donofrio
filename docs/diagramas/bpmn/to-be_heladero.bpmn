<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="def_to_be_heladero" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="colab_to_be_heladero">
    <bpmn:participant id="pool_to_be_heladero" name="TO-BE · Heladero con Odoo estándar (Fase 1, sin M2)" processRef="proc_to_be_heladero" />
  </bpmn:collaboration>
  <bpmn:process id="proc_to_be_heladero" isExecutable="false">
    <bpmn:laneSet id="carriles">
      <bpmn:lane id="carril_0" name="Heladero">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ruta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>vuelve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_1" name="Vendedor">
        <bpmn:flowNodeRef>pedido</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_2" name="Almacén">
        <bpmn:flowNodeRef>despacha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>devuelve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_3" name="Facturación">
        <bpmn:flowNodeRef>nota</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cobra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Inicio de la jornada">
      <bpmn:outgoing>flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="pide" name="Pide su carga de helados del día">
      <bpmn:incoming>flujo_1</bpmn:incoming>
      <bpmn:outgoing>flujo_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="pedido" name="Crea y confirma el pedido con la lista «Heladero»">
      <bpmn:incoming>flujo_2</bpmn:incoming>
      <bpmn:outgoing>flujo_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="despacha" name="Entrega la carga con guía; Odoo descuenta por FEFO">
      <bpmn:incoming>flujo_3</bpmn:incoming>
      <bpmn:outgoing>flujo_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ruta" name="Sale a la ruta y vende">
      <bpmn:incoming>flujo_4</bpmn:incoming>
      <bpmn:outgoing>flujo_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="vuelve" name="Regresa y entrega el sobrante y el efectivo">
      <bpmn:incoming>flujo_5</bpmn:incoming>
      <bpmn:outgoing>flujo_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="devuelve" name="Registra la devolución: el sobrante vuelve al stock">
      <bpmn:incoming>flujo_6</bpmn:incoming>
      <bpmn:outgoing>flujo_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="nota" name="Emite la nota de crédito por lo devuelto">
      <bpmn:incoming>flujo_7</bpmn:incoming>
      <bpmn:outgoing>flujo_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="cobra" name="Cobra lo vendido y registra el pago de la factura">
      <bpmn:incoming>flujo_8</bpmn:incoming>
      <bpmn:outgoing>flujo_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Jornada cerrada">
      <bpmn:incoming>flujo_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flujo_1" sourceRef="inicio" targetRef="pide" />
    <bpmn:sequenceFlow id="flujo_2" sourceRef="pide" targetRef="pedido" />
    <bpmn:sequenceFlow id="flujo_3" sourceRef="pedido" targetRef="despacha" />
    <bpmn:sequenceFlow id="flujo_4" sourceRef="despacha" targetRef="ruta" />
    <bpmn:sequenceFlow id="flujo_5" sourceRef="ruta" targetRef="vuelve" />
    <bpmn:sequenceFlow id="flujo_6" sourceRef="vuelve" targetRef="devuelve" />
    <bpmn:sequenceFlow id="flujo_7" sourceRef="devuelve" targetRef="nota" />
    <bpmn:sequenceFlow id="flujo_8" sourceRef="nota" targetRef="cobra" />
    <bpmn:sequenceFlow id="flujo_9" sourceRef="cobra" targetRef="fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama">
    <bpmndi:BPMNPlane id="plano" bpmnElement="colab_to_be_heladero">
      <bpmndi:BPMNShape id="pool_to_be_heladero_di" bpmnElement="pool_to_be_heladero" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1595" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_0_di" bpmnElement="carril_0" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_1_di" bpmnElement="carril_1" isHorizontal="true">
        <dc:Bounds x="50" y="170" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_2_di" bpmnElement="carril_2" isHorizontal="true">
        <dc:Bounds x="50" y="320" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_3_di" bpmnElement="carril_3" isHorizontal="true">
        <dc:Bounds x="50" y="470" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inicio_di" bpmnElement="inicio">
        <dc:Bounds x="146" y="77" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="104" y="117" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pide_di" bpmnElement="pide">
        <dc:Bounds x="255" y="58" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pedido_di" bpmnElement="pedido">
        <dc:Bounds x="405" y="208" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="despacha_di" bpmnElement="despacha">
        <dc:Bounds x="555" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ruta_di" bpmnElement="ruta">
        <dc:Bounds x="705" y="58" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="vuelve_di" bpmnElement="vuelve">
        <dc:Bounds x="855" y="58" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="devuelve_di" bpmnElement="devuelve">
        <dc:Bounds x="1005" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="nota_di" bpmnElement="nota">
        <dc:Bounds x="1155" y="508" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cobra_di" bpmnElement="cobra">
        <dc:Bounds x="1305" y="508" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_di" bpmnElement="fin">
        <dc:Bounds x="1496" y="527" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1454" y="567" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flujo_1_di" bpmnElement="flujo_1">
        <di:waypoint x="182" y="95" />
        <di:waypoint x="255" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_2_di" bpmnElement="flujo_2">
        <di:waypoint x="373" y="95" />
        <di:waypoint x="389" y="95" />
        <di:waypoint x="389" y="245" />
        <di:waypoint x="405" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_3_di" bpmnElement="flujo_3">
        <di:waypoint x="523" y="245" />
        <di:waypoint x="539" y="245" />
        <di:waypoint x="539" y="395" />
        <di:waypoint x="555" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_4_di" bpmnElement="flujo_4">
        <di:waypoint x="673" y="395" />
        <di:waypoint x="689" y="395" />
        <di:waypoint x="689" y="95" />
        <di:waypoint x="705" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_5_di" bpmnElement="flujo_5">
        <di:waypoint x="823" y="95" />
        <di:waypoint x="855" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_6_di" bpmnElement="flujo_6">
        <di:waypoint x="973" y="95" />
        <di:waypoint x="989" y="95" />
        <di:waypoint x="989" y="395" />
        <di:waypoint x="1005" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_7_di" bpmnElement="flujo_7">
        <di:waypoint x="1123" y="395" />
        <di:waypoint x="1139" y="395" />
        <di:waypoint x="1139" y="545" />
        <di:waypoint x="1155" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_8_di" bpmnElement="flujo_8">
        <di:waypoint x="1273" y="545" />
        <di:waypoint x="1305" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_9_di" bpmnElement="flujo_9">
        <di:waypoint x="1423" y="545" />
        <di:waypoint x="1496" y="545" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
