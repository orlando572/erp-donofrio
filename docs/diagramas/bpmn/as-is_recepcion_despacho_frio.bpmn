<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="def_as_is_recepcion_despacho_frio" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="colab_as_is_recepcion_despacho_frio">
    <bpmn:participant id="pool_as_is_recepcion_despacho_frio" name="AS-IS · Recepción y despacho con cadena de frío" processRef="proc_as_is_recepcion_despacho_frio" />
  </bpmn:collaboration>
  <bpmn:process id="proc_as_is_recepcion_despacho_frio" isExecutable="false">
    <bpmn:laneSet id="carriles">
      <bpmn:lane id="carril_0" name="Proveedor">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_1" name="Cámara de frío">
        <bpmn:flowNodeRef>guarda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>temperatura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rango</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_2" name="Almacén">
        <bpmn:flowNodeRef>recibe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>avisa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>kardex</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_3" name="Despacho">
        <bpmn:flowNodeRef>prepara</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>despacha</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_4" name="Cliente o CD Arequipa">
        <bpmn:flowNodeRef>recibe_cliente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Llega el camión con insumos">
      <bpmn:outgoing>flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="recibe" name="Descarga y recibe con la guía, sin registrar lote ni vencimiento">
      <bpmn:incoming>flujo_1</bpmn:incoming>
      <bpmn:outgoing>flujo_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="guarda" name="Guarda el producto en la cámara que corresponde">
      <bpmn:incoming>flujo_2</bpmn:incoming>
      <bpmn:outgoing>flujo_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="temperatura" name="Anota la temperatura en una planilla de papel, dos veces al día">
      <bpmn:incoming>flujo_3</bpmn:incoming>
      <bpmn:outgoing>flujo_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="rango" name="¿Fuera de rango?">
      <bpmn:incoming>flujo_4</bpmn:incoming>
      <bpmn:outgoing>flujo_5</bpmn:outgoing>
      <bpmn:outgoing>flujo_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="avisa" name="Detecta tarde el problema y avisa por llamada al jefe">
      <bpmn:incoming>flujo_5</bpmn:incoming>
      <bpmn:outgoing>flujo_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="kardex" name="Registra salidas y saldos en el kárdex de Excel">
      <bpmn:incoming>flujo_6</bpmn:incoming>
      <bpmn:incoming>flujo_7</bpmn:incoming>
      <bpmn:outgoing>flujo_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="prepara" name="Prepara el pedido revisando las fechas a ojo, sin FEFO">
      <bpmn:incoming>flujo_8</bpmn:incoming>
      <bpmn:outgoing>flujo_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="despacha" name="Despacha con guía en papel; Arequipa se coordina por teléfono">
      <bpmn:incoming>flujo_9</bpmn:incoming>
      <bpmn:outgoing>flujo_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="recibe_cliente" name="Recibe la mercadería y firma la guía">
      <bpmn:incoming>flujo_10</bpmn:incoming>
      <bpmn:outgoing>flujo_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Entrega cerrada">
      <bpmn:incoming>flujo_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flujo_1" sourceRef="inicio" targetRef="recibe" />
    <bpmn:sequenceFlow id="flujo_2" sourceRef="recibe" targetRef="guarda" />
    <bpmn:sequenceFlow id="flujo_3" sourceRef="guarda" targetRef="temperatura" />
    <bpmn:sequenceFlow id="flujo_4" sourceRef="temperatura" targetRef="rango" />
    <bpmn:sequenceFlow id="flujo_5" name="Sí" sourceRef="rango" targetRef="avisa" />
    <bpmn:sequenceFlow id="flujo_6" name="No" sourceRef="rango" targetRef="kardex" />
    <bpmn:sequenceFlow id="flujo_7" sourceRef="avisa" targetRef="kardex" />
    <bpmn:sequenceFlow id="flujo_8" sourceRef="kardex" targetRef="prepara" />
    <bpmn:sequenceFlow id="flujo_9" sourceRef="prepara" targetRef="despacha" />
    <bpmn:sequenceFlow id="flujo_10" sourceRef="despacha" targetRef="recibe_cliente" />
    <bpmn:sequenceFlow id="flujo_11" sourceRef="recibe_cliente" targetRef="fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama">
    <bpmndi:BPMNPlane id="plano" bpmnElement="colab_as_is_recepcion_despacho_frio">
      <bpmndi:BPMNShape id="pool_as_is_recepcion_despacho_frio_di" bpmnElement="pool_as_is_recepcion_despacho_frio" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1745" height="750" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_0_di" bpmnElement="carril_0" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1715" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_1_di" bpmnElement="carril_1" isHorizontal="true">
        <dc:Bounds x="50" y="170" width="1715" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_2_di" bpmnElement="carril_2" isHorizontal="true">
        <dc:Bounds x="50" y="320" width="1715" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_3_di" bpmnElement="carril_3" isHorizontal="true">
        <dc:Bounds x="50" y="470" width="1715" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_4_di" bpmnElement="carril_4" isHorizontal="true">
        <dc:Bounds x="50" y="620" width="1715" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inicio_di" bpmnElement="inicio">
        <dc:Bounds x="146" y="77" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="104" y="117" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="recibe_di" bpmnElement="recibe" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="255" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="guarda_di" bpmnElement="guarda">
        <dc:Bounds x="405" y="208" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="temperatura_di" bpmnElement="temperatura" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="555" y="208" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rango_di" bpmnElement="rango" isMarkerVisible="true">
        <dc:Bounds x="739" y="220" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="704" y="186" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="avisa_di" bpmnElement="avisa" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="855" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="kardex_di" bpmnElement="kardex" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="1005" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="prepara_di" bpmnElement="prepara" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="1155" y="508" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="despacha_di" bpmnElement="despacha" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="1305" y="508" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="recibe_cliente_di" bpmnElement="recibe_cliente">
        <dc:Bounds x="1455" y="658" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_di" bpmnElement="fin">
        <dc:Bounds x="1646" y="677" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1604" y="717" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flujo_1_di" bpmnElement="flujo_1">
        <di:waypoint x="182" y="95" />
        <di:waypoint x="239" y="95" />
        <di:waypoint x="239" y="395" />
        <di:waypoint x="255" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_2_di" bpmnElement="flujo_2">
        <di:waypoint x="373" y="395" />
        <di:waypoint x="389" y="395" />
        <di:waypoint x="389" y="245" />
        <di:waypoint x="405" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_3_di" bpmnElement="flujo_3">
        <di:waypoint x="523" y="245" />
        <di:waypoint x="555" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_4_di" bpmnElement="flujo_4">
        <di:waypoint x="673" y="245" />
        <di:waypoint x="739" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_5_di" bpmnElement="flujo_5">
        <di:waypoint x="764" y="270" />
        <di:waypoint x="764" y="395" />
        <di:waypoint x="855" y="395" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="770" y="274" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_6_di" bpmnElement="flujo_6">
        <di:waypoint x="789" y="245" />
        <di:waypoint x="989" y="245" />
        <di:waypoint x="989" y="395" />
        <di:waypoint x="1005" y="395" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="795" y="225" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_7_di" bpmnElement="flujo_7">
        <di:waypoint x="973" y="395" />
        <di:waypoint x="1005" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_8_di" bpmnElement="flujo_8">
        <di:waypoint x="1123" y="395" />
        <di:waypoint x="1139" y="395" />
        <di:waypoint x="1139" y="545" />
        <di:waypoint x="1155" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_9_di" bpmnElement="flujo_9">
        <di:waypoint x="1273" y="545" />
        <di:waypoint x="1305" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_10_di" bpmnElement="flujo_10">
        <di:waypoint x="1423" y="545" />
        <di:waypoint x="1439" y="545" />
        <di:waypoint x="1439" y="695" />
        <di:waypoint x="1455" y="695" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_11_di" bpmnElement="flujo_11">
        <di:waypoint x="1573" y="695" />
        <di:waypoint x="1646" y="695" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
