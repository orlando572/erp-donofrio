<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="def_as_is_produccion_calidad" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="colab_as_is_produccion_calidad">
    <bpmn:participant id="pool_as_is_produccion_calidad" name="AS-IS · Producción y calidad" processRef="proc_as_is_produccion_calidad" />
  </bpmn:collaboration>
  <bpmn:process id="proc_as_is_produccion_calidad" isExecutable="false">
    <bpmn:laneSet id="carriles">
      <bpmn:lane id="carril_0" name="Jefe de Producción">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>programa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_1" name="Calidad">
        <bpmn:flowNodeRef>inspecciona</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cumple</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_no</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_2" name="Operario de línea">
        <bpmn:flowNodeRef>produce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anota</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>etiqueta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_3" name="Almacén">
        <bpmn:flowNodeRef>insumos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>kardex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Llega la demanda del mes o de la campaña">
      <bpmn:outgoing>flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="programa" name="Programa la producción en Excel y imprime la orden">
      <bpmn:incoming>flujo_1</bpmn:incoming>
      <bpmn:outgoing>flujo_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="insumos" name="Entrega los insumos con un vale de papel, sin lote ni vencimiento">
      <bpmn:incoming>flujo_2</bpmn:incoming>
      <bpmn:outgoing>flujo_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="produce" name="Produce siguiendo la fórmula impresa">
      <bpmn:incoming>flujo_3</bpmn:incoming>
      <bpmn:outgoing>flujo_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="anota" name="Anota a mano las temperaturas de cada etapa (80-85 °C)">
      <bpmn:incoming>flujo_4</bpmn:incoming>
      <bpmn:outgoing>flujo_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="inspecciona" name="Inspecciona una muestra y llena el formato en papel">
      <bpmn:incoming>flujo_5</bpmn:incoming>
      <bpmn:outgoing>flujo_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="cumple" name="¿El lote cumple?">
      <bpmn:incoming>flujo_6</bpmn:incoming>
      <bpmn:outgoing>flujo_7</bpmn:outgoing>
      <bpmn:outgoing>flujo_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="decide" name="Decide a criterio si se reprocesa o se descarta, sin registro">
      <bpmn:incoming>flujo_7</bpmn:incoming>
      <bpmn:outgoing>flujo_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin_no" name="Lote reprocesado o descartado">
      <bpmn:incoming>flujo_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="etiqueta" name="Etiqueta el lote con un código manual y lo envía al almacén">
      <bpmn:incoming>flujo_8</bpmn:incoming>
      <bpmn:outgoing>flujo_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="kardex" name="Registra la entrada en el kárdex de Excel">
      <bpmn:incoming>flujo_10</bpmn:incoming>
      <bpmn:outgoing>flujo_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Producto terminado en almacén">
      <bpmn:incoming>flujo_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flujo_1" sourceRef="inicio" targetRef="programa" />
    <bpmn:sequenceFlow id="flujo_2" sourceRef="programa" targetRef="insumos" />
    <bpmn:sequenceFlow id="flujo_3" sourceRef="insumos" targetRef="produce" />
    <bpmn:sequenceFlow id="flujo_4" sourceRef="produce" targetRef="anota" />
    <bpmn:sequenceFlow id="flujo_5" sourceRef="anota" targetRef="inspecciona" />
    <bpmn:sequenceFlow id="flujo_6" sourceRef="inspecciona" targetRef="cumple" />
    <bpmn:sequenceFlow id="flujo_7" name="No" sourceRef="cumple" targetRef="decide" />
    <bpmn:sequenceFlow id="flujo_8" name="Sí" sourceRef="cumple" targetRef="etiqueta" />
    <bpmn:sequenceFlow id="flujo_9" sourceRef="decide" targetRef="fin_no" />
    <bpmn:sequenceFlow id="flujo_10" sourceRef="etiqueta" targetRef="kardex" />
    <bpmn:sequenceFlow id="flujo_11" sourceRef="kardex" targetRef="fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama">
    <bpmndi:BPMNPlane id="plano" bpmnElement="colab_as_is_produccion_calidad">
      <bpmndi:BPMNShape id="pool_as_is_produccion_calidad_di" bpmnElement="pool_as_is_produccion_calidad" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1595" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_0_di" bpmnElement="carril_0" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_1_di" bpmnElement="carril_1" isHorizontal="true">
        <dc:Bounds x="50" y="170" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_2_di" bpmnElement="carril_2" isHorizontal="true">
        <dc:Bounds x="50" y="320" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_3_di" bpmnElement="carril_3" isHorizontal="true">
        <dc:Bounds x="50" y="470" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inicio_di" bpmnElement="inicio">
        <dc:Bounds x="146" y="77" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="104" y="117" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="programa_di" bpmnElement="programa" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="255" y="58" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="insumos_di" bpmnElement="insumos" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="405" y="508" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="produce_di" bpmnElement="produce">
        <dc:Bounds x="555" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="anota_di" bpmnElement="anota" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="705" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inspecciona_di" bpmnElement="inspecciona" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="855" y="208" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cumple_di" bpmnElement="cumple" isMarkerVisible="true">
        <dc:Bounds x="1039" y="220" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1004" y="186" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decide_di" bpmnElement="decide" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="1155" y="208" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_no_di" bpmnElement="fin_no">
        <dc:Bounds x="1346" y="227" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1304" y="267" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="etiqueta_di" bpmnElement="etiqueta" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="1155" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="kardex_di" bpmnElement="kardex" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="1305" y="508" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_di" bpmnElement="fin">
        <dc:Bounds x="1496" y="527" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1454" y="567" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flujo_1_di" bpmnElement="flujo_1">
        <di:waypoint x="182" y="95" />
        <di:waypoint x="255" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_2_di" bpmnElement="flujo_2">
        <di:waypoint x="373" y="95" />
        <di:waypoint x="389" y="95" />
        <di:waypoint x="389" y="545" />
        <di:waypoint x="405" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_3_di" bpmnElement="flujo_3">
        <di:waypoint x="523" y="545" />
        <di:waypoint x="539" y="545" />
        <di:waypoint x="539" y="395" />
        <di:waypoint x="555" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_4_di" bpmnElement="flujo_4">
        <di:waypoint x="673" y="395" />
        <di:waypoint x="705" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_5_di" bpmnElement="flujo_5">
        <di:waypoint x="823" y="395" />
        <di:waypoint x="839" y="395" />
        <di:waypoint x="839" y="245" />
        <di:waypoint x="855" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_6_di" bpmnElement="flujo_6">
        <di:waypoint x="973" y="245" />
        <di:waypoint x="1039" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_7_di" bpmnElement="flujo_7">
        <di:waypoint x="1089" y="245" />
        <di:waypoint x="1155" y="245" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1095" y="225" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_8_di" bpmnElement="flujo_8">
        <di:waypoint x="1064" y="270" />
        <di:waypoint x="1064" y="395" />
        <di:waypoint x="1155" y="395" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1070" y="274" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_9_di" bpmnElement="flujo_9">
        <di:waypoint x="1273" y="245" />
        <di:waypoint x="1346" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_10_di" bpmnElement="flujo_10">
        <di:waypoint x="1273" y="395" />
        <di:waypoint x="1289" y="395" />
        <di:waypoint x="1289" y="545" />
        <di:waypoint x="1305" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_11_di" bpmnElement="flujo_11">
        <di:waypoint x="1423" y="545" />
        <di:waypoint x="1496" y="545" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
