<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="def_to_be_recepcion_despacho" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="colab_to_be_recepcion_despacho">
    <bpmn:participant id="pool_to_be_recepcion_despacho" name="TO-BE · Recepción y despacho con Odoo estándar (Fase 1)" processRef="proc_to_be_recepcion_despacho" />
  </bpmn:collaboration>
  <bpmn:process id="proc_to_be_recepcion_despacho" isExecutable="false">
    <bpmn:laneSet id="carriles">
      <bpmn:lane id="carril_0" name="Proveedor">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_1" name="Almacén">
        <bpmn:flowNodeRef>recibe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guarda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alerta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_2" name="Despacho">
        <bpmn:flowNodeRef>pedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>destino</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_3" name="Cliente">
        <bpmn:flowNodeRef>cliente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_4" name="CD Arequipa">
        <bpmn:flowNodeRef>transito</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Llega el camión con una orden de compra confirmada">
      <bpmn:outgoing>flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="recibe" name="Recibe contra la recepción que creó la OC y escribe lote y vencimiento">
      <bpmn:incoming>flujo_1</bpmn:incoming>
      <bpmn:outgoing>flujo_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="guarda" name="Odoo guarda el lote en su cámara y valoriza el stock por FIFO">
      <bpmn:incoming>flujo_2</bpmn:incoming>
      <bpmn:outgoing>flujo_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="alerta" name="Odoo avisa al jefe de almacén 30 días antes de que el lote venza">
      <bpmn:incoming>flujo_3</bpmn:incoming>
      <bpmn:outgoing>flujo_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="pedido" name="Llega un pedido confirmado o una reposición a Arequipa">
      <bpmn:incoming>flujo_4</bpmn:incoming>
      <bpmn:outgoing>flujo_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="pick" name="Pick: Odoo reserva por FEFO y arma la lista de recolección">
      <bpmn:incoming>flujo_5</bpmn:incoming>
      <bpmn:outgoing>flujo_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ship" name="Ship: verifica el pick, despacha desde la zona de salida y emite la guía">
      <bpmn:incoming>flujo_6</bpmn:incoming>
      <bpmn:outgoing>flujo_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="destino" name="¿Quién recibe?">
      <bpmn:incoming>flujo_7</bpmn:incoming>
      <bpmn:outgoing>flujo_8</bpmn:outgoing>
      <bpmn:outgoing>flujo_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="cliente" name="El cliente recibe y firma la entrega">
      <bpmn:incoming>flujo_8</bpmn:incoming>
      <bpmn:outgoing>flujo_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="transito" name="El CD Arequipa recibe la transferencia y el stock queda en AQP">
      <bpmn:incoming>flujo_9</bpmn:incoming>
      <bpmn:outgoing>flujo_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Entrega cerrada">
      <bpmn:incoming>flujo_10</bpmn:incoming>
      <bpmn:incoming>flujo_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flujo_1" sourceRef="inicio" targetRef="recibe" />
    <bpmn:sequenceFlow id="flujo_2" sourceRef="recibe" targetRef="guarda" />
    <bpmn:sequenceFlow id="flujo_3" sourceRef="guarda" targetRef="alerta" />
    <bpmn:sequenceFlow id="flujo_4" sourceRef="alerta" targetRef="pedido" />
    <bpmn:sequenceFlow id="flujo_5" sourceRef="pedido" targetRef="pick" />
    <bpmn:sequenceFlow id="flujo_6" sourceRef="pick" targetRef="ship" />
    <bpmn:sequenceFlow id="flujo_7" sourceRef="ship" targetRef="destino" />
    <bpmn:sequenceFlow id="flujo_8" name="Cliente" sourceRef="destino" targetRef="cliente" />
    <bpmn:sequenceFlow id="flujo_9" name="Arequipa" sourceRef="destino" targetRef="transito" />
    <bpmn:sequenceFlow id="flujo_10" sourceRef="cliente" targetRef="fin" />
    <bpmn:sequenceFlow id="flujo_11" sourceRef="transito" targetRef="fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama">
    <bpmndi:BPMNPlane id="plano" bpmnElement="colab_to_be_recepcion_despacho">
      <bpmndi:BPMNShape id="pool_to_be_recepcion_despacho_di" bpmnElement="pool_to_be_recepcion_despacho" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1595" height="750" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_0_di" bpmnElement="carril_0" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_1_di" bpmnElement="carril_1" isHorizontal="true">
        <dc:Bounds x="50" y="170" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_2_di" bpmnElement="carril_2" isHorizontal="true">
        <dc:Bounds x="50" y="320" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_3_di" bpmnElement="carril_3" isHorizontal="true">
        <dc:Bounds x="50" y="470" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_4_di" bpmnElement="carril_4" isHorizontal="true">
        <dc:Bounds x="50" y="620" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inicio_di" bpmnElement="inicio">
        <dc:Bounds x="146" y="77" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="104" y="117" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="recibe_di" bpmnElement="recibe">
        <dc:Bounds x="255" y="208" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="guarda_di" bpmnElement="guarda">
        <dc:Bounds x="405" y="208" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="alerta_di" bpmnElement="alerta">
        <dc:Bounds x="555" y="208" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pedido_di" bpmnElement="pedido">
        <dc:Bounds x="705" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pick_di" bpmnElement="pick">
        <dc:Bounds x="855" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ship_di" bpmnElement="ship">
        <dc:Bounds x="1005" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="destino_di" bpmnElement="destino" isMarkerVisible="true">
        <dc:Bounds x="1189" y="370" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1154" y="336" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cliente_di" bpmnElement="cliente">
        <dc:Bounds x="1305" y="508" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="transito_di" bpmnElement="transito">
        <dc:Bounds x="1305" y="658" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_di" bpmnElement="fin">
        <dc:Bounds x="1496" y="527" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1454" y="567" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flujo_1_di" bpmnElement="flujo_1">
        <di:waypoint x="182" y="95" />
        <di:waypoint x="239" y="95" />
        <di:waypoint x="239" y="245" />
        <di:waypoint x="255" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_2_di" bpmnElement="flujo_2">
        <di:waypoint x="373" y="245" />
        <di:waypoint x="405" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_3_di" bpmnElement="flujo_3">
        <di:waypoint x="523" y="245" />
        <di:waypoint x="555" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_4_di" bpmnElement="flujo_4">
        <di:waypoint x="673" y="245" />
        <di:waypoint x="689" y="245" />
        <di:waypoint x="689" y="395" />
        <di:waypoint x="705" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_5_di" bpmnElement="flujo_5">
        <di:waypoint x="823" y="395" />
        <di:waypoint x="855" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_6_di" bpmnElement="flujo_6">
        <di:waypoint x="973" y="395" />
        <di:waypoint x="1005" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_7_di" bpmnElement="flujo_7">
        <di:waypoint x="1123" y="395" />
        <di:waypoint x="1189" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_8_di" bpmnElement="flujo_8">
        <di:waypoint x="1239" y="395" />
        <di:waypoint x="1289" y="395" />
        <di:waypoint x="1289" y="545" />
        <di:waypoint x="1305" y="545" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1245" y="375" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_9_di" bpmnElement="flujo_9">
        <di:waypoint x="1214" y="420" />
        <di:waypoint x="1214" y="695" />
        <di:waypoint x="1305" y="695" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1220" y="424" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_10_di" bpmnElement="flujo_10">
        <di:waypoint x="1423" y="545" />
        <di:waypoint x="1496" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_11_di" bpmnElement="flujo_11">
        <di:waypoint x="1423" y="695" />
        <di:waypoint x="1480" y="695" />
        <di:waypoint x="1480" y="545" />
        <di:waypoint x="1496" y="545" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
