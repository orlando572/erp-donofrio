<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="def_to_be_produccion_m1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="colab_to_be_produccion_m1">
    <bpmn:participant id="pool_to_be_produccion_m1" name="TO-BE · Producción con inspección de calidad (M1, Fase 2)" processRef="proc_to_be_produccion_m1" />
  </bpmn:collaboration>
  <bpmn:process id="proc_to_be_produccion_m1" isExecutable="false">
    <bpmn:laneSet id="carriles">
      <bpmn:lane id="carril_0" name="Operario de línea">
        <bpmn:flowNodeRef>produce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>termina</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_1" name="Almacén">
        <bpmn:flowNodeRef>libera</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_2" name="Inspector de Calidad">
        <bpmn:flowNodeRef>inspeccion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aprueba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>certifica</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_3" name="Jefe de Producción">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rechaza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_no</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Llega la demanda del mes o de la campaña">
      <bpmn:outgoing>flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="op" name="Crea la orden desde la receta y Odoo reserva los insumos por FEFO">
      <bpmn:incoming>flujo_1</bpmn:incoming>
      <bpmn:outgoing>flujo_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="produce" name="Ejecuta las operaciones y registra los tiempos">
      <bpmn:incoming>flujo_2</bpmn:incoming>
      <bpmn:outgoing>flujo_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="termina" name="Termina la orden: Odoo crea el lote con su vencimiento">
      <bpmn:incoming>flujo_3</bpmn:incoming>
      <bpmn:outgoing>flujo_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="inspeccion" name="Se crea la inspección ligada a la orden y al lote">
      <bpmn:incoming>flujo_4</bpmn:incoming>
      <bpmn:outgoing>flujo_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="mide" name="Mide en cada punto de control (pasteurización, peso, microbiología)">
      <bpmn:incoming>flujo_5</bpmn:incoming>
      <bpmn:outgoing>flujo_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="aprueba" name="¿Aprueba el lote?">
      <bpmn:incoming>flujo_6</bpmn:incoming>
      <bpmn:outgoing>flujo_7</bpmn:outgoing>
      <bpmn:outgoing>flujo_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="certifica" name="Emite el certificado de calidad del lote">
      <bpmn:incoming>flujo_7</bpmn:incoming>
      <bpmn:outgoing>flujo_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="rechaza" name="Lote rechazado: Odoo bloquea su despacho; el jefe decide su destino">
      <bpmn:incoming>flujo_8</bpmn:incoming>
      <bpmn:outgoing>flujo_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin_no" name="Lote reprocesado o descartado">
      <bpmn:incoming>flujo_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="libera" name="El lote liberado queda disponible para el despacho FEFO">
      <bpmn:incoming>flujo_10</bpmn:incoming>
      <bpmn:outgoing>flujo_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Lote liberado en almacén">
      <bpmn:incoming>flujo_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flujo_1" sourceRef="inicio" targetRef="op" />
    <bpmn:sequenceFlow id="flujo_2" sourceRef="op" targetRef="produce" />
    <bpmn:sequenceFlow id="flujo_3" sourceRef="produce" targetRef="termina" />
    <bpmn:sequenceFlow id="flujo_4" sourceRef="termina" targetRef="inspeccion" />
    <bpmn:sequenceFlow id="flujo_5" sourceRef="inspeccion" targetRef="mide" />
    <bpmn:sequenceFlow id="flujo_6" sourceRef="mide" targetRef="aprueba" />
    <bpmn:sequenceFlow id="flujo_7" name="Sí" sourceRef="aprueba" targetRef="certifica" />
    <bpmn:sequenceFlow id="flujo_8" name="No" sourceRef="aprueba" targetRef="rechaza" />
    <bpmn:sequenceFlow id="flujo_9" sourceRef="rechaza" targetRef="fin_no" />
    <bpmn:sequenceFlow id="flujo_10" sourceRef="certifica" targetRef="libera" />
    <bpmn:sequenceFlow id="flujo_11" sourceRef="libera" targetRef="fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama">
    <bpmndi:BPMNPlane id="plano" bpmnElement="colab_to_be_produccion_m1">
      <bpmndi:BPMNShape id="pool_to_be_produccion_m1_di" bpmnElement="pool_to_be_produccion_m1" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1595" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_0_di" bpmnElement="carril_0" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_1_di" bpmnElement="carril_1" isHorizontal="true">
        <dc:Bounds x="50" y="170" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_2_di" bpmnElement="carril_2" isHorizontal="true">
        <dc:Bounds x="50" y="320" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_3_di" bpmnElement="carril_3" isHorizontal="true">
        <dc:Bounds x="50" y="470" width="1565" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inicio_di" bpmnElement="inicio">
        <dc:Bounds x="146" y="527" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="104" y="567" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="op_di" bpmnElement="op">
        <dc:Bounds x="255" y="508" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="produce_di" bpmnElement="produce">
        <dc:Bounds x="405" y="58" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="termina_di" bpmnElement="termina">
        <dc:Bounds x="555" y="58" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inspeccion_di" bpmnElement="inspeccion">
        <dc:Bounds x="705" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mide_di" bpmnElement="mide">
        <dc:Bounds x="855" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="aprueba_di" bpmnElement="aprueba" isMarkerVisible="true">
        <dc:Bounds x="1039" y="370" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1004" y="336" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="certifica_di" bpmnElement="certifica">
        <dc:Bounds x="1155" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rechaza_di" bpmnElement="rechaza">
        <dc:Bounds x="1155" y="508" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_no_di" bpmnElement="fin_no">
        <dc:Bounds x="1346" y="527" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1304" y="567" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="libera_di" bpmnElement="libera">
        <dc:Bounds x="1305" y="208" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_di" bpmnElement="fin">
        <dc:Bounds x="1496" y="227" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1454" y="267" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flujo_1_di" bpmnElement="flujo_1">
        <di:waypoint x="182" y="545" />
        <di:waypoint x="255" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_2_di" bpmnElement="flujo_2">
        <di:waypoint x="373" y="545" />
        <di:waypoint x="389" y="545" />
        <di:waypoint x="389" y="95" />
        <di:waypoint x="405" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_3_di" bpmnElement="flujo_3">
        <di:waypoint x="523" y="95" />
        <di:waypoint x="555" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_4_di" bpmnElement="flujo_4">
        <di:waypoint x="673" y="95" />
        <di:waypoint x="689" y="95" />
        <di:waypoint x="689" y="395" />
        <di:waypoint x="705" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_5_di" bpmnElement="flujo_5">
        <di:waypoint x="823" y="395" />
        <di:waypoint x="855" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_6_di" bpmnElement="flujo_6">
        <di:waypoint x="973" y="395" />
        <di:waypoint x="1039" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_7_di" bpmnElement="flujo_7">
        <di:waypoint x="1089" y="395" />
        <di:waypoint x="1155" y="395" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1095" y="375" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_8_di" bpmnElement="flujo_8">
        <di:waypoint x="1064" y="420" />
        <di:waypoint x="1064" y="545" />
        <di:waypoint x="1155" y="545" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1070" y="424" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_9_di" bpmnElement="flujo_9">
        <di:waypoint x="1273" y="545" />
        <di:waypoint x="1346" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_10_di" bpmnElement="flujo_10">
        <di:waypoint x="1273" y="395" />
        <di:waypoint x="1289" y="395" />
        <di:waypoint x="1289" y="245" />
        <di:waypoint x="1305" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_11_di" bpmnElement="flujo_11">
        <di:waypoint x="1423" y="245" />
        <di:waypoint x="1496" y="245" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
