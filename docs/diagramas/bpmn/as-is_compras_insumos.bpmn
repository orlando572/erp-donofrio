      <bpmndi:BPMNEdge id="flujo_8_di" bpmnElement="flujo_8">
        <di:waypoint x="1273" y="245" />
        <di:waypoint x="1289" y="245" />
        <di:waypoint x="1289" y="545" />
        <di:waypoint x="1305" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_9_di" bpmnElement="flujo_9">
        <di:waypoint x="1423" y="545" />
        <di:waypoint x="1439" y="545" />
        <di:waypoint x="1439" y="95" />
        <di:waypoint x="1455" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_10_di" bpmnElement="flujo_10">
        <di:waypoint x="1573" y="95" />
        <di:waypoint x="1589" y="95" />
        <di:waypoint x="1589" y="695" />
        <di:waypoint x="1605" y="695" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_11_di" bpmnElement="flujo_11">
        <di:waypoint x="1723" y="695" />
        <di:waypoint x="1796" y="695" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
