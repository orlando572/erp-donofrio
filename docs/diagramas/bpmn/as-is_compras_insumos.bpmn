<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="def_as_is_compras_insumos" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="colab_as_is_compras_insumos">
    <bpmn:participant id="pool_as_is_compras_insumos" name="AS-IS · Compra de insumos" processRef="proc_as_is_compras_insumos" />
  </bpmn:collaboration>
  <bpmn:process id="proc_as_is_compras_insumos" isExecutable="false">
    <bpmn:laneSet id="carriles">
      <bpmn:lane id="carril_0" name="Almacén">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revisa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recibe</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_1" name="Compras">
        <bpmn:flowNodeRef>cotiza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compara</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_2" name="Gerencia">
        <bpmn:flowNodeRef>firma</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_3" name="Proveedor">
        <bpmn:flowNodeRef>envia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>entrega</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="carril_4" name="Finanzas">
        <bpmn:flowNodeRef>digita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Baja el stock de un insumo">
      <bpmn:outgoing>flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="revisa" name="Revisa el stock a simple vista y detecta el faltante">
      <bpmn:incoming>flujo_1</bpmn:incoming>
      <bpmn:outgoing>flujo_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="pide" name="Pide la compra por correo a Compras">
      <bpmn:incoming>flujo_2</bpmn:incoming>
      <bpmn:outgoing>flujo_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="cotiza" name="Pide cotizaciones por teléfono y correo">
      <bpmn:incoming>flujo_3</bpmn:incoming>
      <bpmn:outgoing>flujo_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="envia" name="Envía su cotización">
      <bpmn:incoming>flujo_4</bpmn:incoming>
      <bpmn:outgoing>flujo_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="compara" name="Compara en Excel y elige proveedor">
      <bpmn:incoming>flujo_5</bpmn:incoming>
      <bpmn:outgoing>flujo_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="firma" name="Firma la aprobación en papel">
      <bpmn:incoming>flujo_6</bpmn:incoming>
      <bpmn:outgoing>flujo_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="oc" name="Emite la orden de compra en Word y la envía">
      <bpmn:incoming>flujo_7</bpmn:incoming>
      <bpmn:outgoing>flujo_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="entrega" name="Entrega los insumos con guía y factura">
      <bpmn:incoming>flujo_8</bpmn:incoming>
      <bpmn:outgoing>flujo_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="recibe" name="Recibe y firma la guía, sin registrar lote ni vencimiento">
      <bpmn:incoming>flujo_9</bpmn:incoming>
      <bpmn:outgoing>flujo_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="digita" name="Digita la factura del proveedor y programa el pago">
      <bpmn:incoming>flujo_10</bpmn:incoming>
      <bpmn:outgoing>flujo_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Compra cerrada">
      <bpmn:incoming>flujo_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flujo_1" sourceRef="inicio" targetRef="revisa" />
    <bpmn:sequenceFlow id="flujo_2" sourceRef="revisa" targetRef="pide" />
    <bpmn:sequenceFlow id="flujo_3" sourceRef="pide" targetRef="cotiza" />
    <bpmn:sequenceFlow id="flujo_4" sourceRef="cotiza" targetRef="envia" />
    <bpmn:sequenceFlow id="flujo_5" sourceRef="envia" targetRef="compara" />
    <bpmn:sequenceFlow id="flujo_6" sourceRef="compara" targetRef="firma" />
    <bpmn:sequenceFlow id="flujo_7" sourceRef="firma" targetRef="oc" />
    <bpmn:sequenceFlow id="flujo_8" sourceRef="oc" targetRef="entrega" />
    <bpmn:sequenceFlow id="flujo_9" sourceRef="entrega" targetRef="recibe" />
    <bpmn:sequenceFlow id="flujo_10" sourceRef="recibe" targetRef="digita" />
    <bpmn:sequenceFlow id="flujo_11" sourceRef="digita" targetRef="fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama">
    <bpmndi:BPMNPlane id="plano" bpmnElement="colab_as_is_compras_insumos">
      <bpmndi:BPMNShape id="pool_as_is_compras_insumos_di" bpmnElement="pool_as_is_compras_insumos" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1895" height="750" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_0_di" bpmnElement="carril_0" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1865" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_1_di" bpmnElement="carril_1" isHorizontal="true">
        <dc:Bounds x="50" y="170" width="1865" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_2_di" bpmnElement="carril_2" isHorizontal="true">
        <dc:Bounds x="50" y="320" width="1865" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_3_di" bpmnElement="carril_3" isHorizontal="true">
        <dc:Bounds x="50" y="470" width="1865" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carril_4_di" bpmnElement="carril_4" isHorizontal="true">
        <dc:Bounds x="50" y="620" width="1865" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inicio_di" bpmnElement="inicio">
        <dc:Bounds x="146" y="77" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="104" y="117" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="revisa_di" bpmnElement="revisa" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="255" y="58" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pide_di" bpmnElement="pide">
        <dc:Bounds x="405" y="58" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cotiza_di" bpmnElement="cotiza">
        <dc:Bounds x="555" y="208" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="envia_di" bpmnElement="envia">
        <dc:Bounds x="705" y="508" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="compara_di" bpmnElement="compara" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="855" y="208" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="firma_di" bpmnElement="firma" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="1005" y="358" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="oc_di" bpmnElement="oc" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="1155" y="208" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="entrega_di" bpmnElement="entrega">
        <dc:Bounds x="1305" y="508" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="recibe_di" bpmnElement="recibe" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="1455" y="58" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="digita_di" bpmnElement="digita" bioc:fill="#fde0dc" bioc:stroke="#c0392b">
        <dc:Bounds x="1605" y="658" width="118" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_di" bpmnElement="fin">
        <dc:Bounds x="1796" y="677" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1754" y="717" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flujo_1_di" bpmnElement="flujo_1">
        <di:waypoint x="182" y="95" />
        <di:waypoint x="255" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_2_di" bpmnElement="flujo_2">
        <di:waypoint x="373" y="95" />
        <di:waypoint x="405" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_3_di" bpmnElement="flujo_3">
        <di:waypoint x="523" y="95" />
        <di:waypoint x="539" y="95" />
        <di:waypoint x="539" y="245" />
        <di:waypoint x="555" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_4_di" bpmnElement="flujo_4">
        <di:waypoint x="673" y="245" />
        <di:waypoint x="689" y="245" />
        <di:waypoint x="689" y="545" />
        <di:waypoint x="705" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_5_di" bpmnElement="flujo_5">
        <di:waypoint x="823" y="545" />
        <di:waypoint x="839" y="545" />
        <di:waypoint x="839" y="245" />
        <di:waypoint x="855" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_6_di" bpmnElement="flujo_6">
        <di:waypoint x="973" y="245" />
        <di:waypoint x="989" y="245" />
        <di:waypoint x="989" y="395" />
        <di:waypoint x="1005" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_7_di" bpmnElement="flujo_7">
        <di:waypoint x="1123" y="395" />
        <di:waypoint x="1139" y="395" />
        <di:waypoint x="1139" y="245" />
        <di:waypoint x="1155" y="245" />
