@startuml cu_heladeros
' Casos de uso de Heladeros (CU004). RF004 es Fase 2 (donofrio_heladeros, M2): implementado.
' Sin la Fase 2 se cubre con la variante estándar: pedido de venta al heladero + devolución.
left to right direction
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F4F7FB
  BorderColor #222222
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #222222
}
title Casos de uso: Heladeros

actor "Supervisor de Heladeros" as SUP
actor "Liquidador de Heladeros" as LIQ
actor "Heladero\n(concesionario)" as HEL

rectangle "ERP D'Onofrio (Odoo 19 Community)" {
  usecase "CU004-F1\nVender al heladero y recibir\nla devolución (estándar)" as F1 #E8F5E9
  usecase "CU004\nLiquidar al heladero del día\n(implementado, Fase 2 · M2)" as CU004 #FFF3CD
  usecase "Registrar despachado,\ndevuelto y merma" as REG #FFF3CD
  usecase "Calcular vendido, importe\ny comisión" as CAL #FFF3CD
  usecase "Emitir PDF de liquidación\ncon firmas" as PDF #FFF3CD
}

SUP --> F1 : programa la carga
LIQ --> F1
LIQ --> CU004
HEL --> F1 : retira y devuelve
HEL --> CU004 : firma la liquidación

CU004 ..> REG : <<include>>
CU004 ..> CAL : <<include>>
CU004 ..> PDF : <<include>>
CU004 ..> F1 : reemplaza el cálculo\nmanual de la devolución

legend right
  Verde: implementable con Odoo estándar (Fase 1).
  Amarillo: módulo propio donofrio_heladeros (M2),
  implementado (release v1.2.0).
endlegend
@enduml
