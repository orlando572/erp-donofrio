<!-- HU-07: centros de trabajo y recetas (listas de materiales con operaciones) (03 §3.3 c).
     En Community las operaciones no tienen campo de instrucciones: los controles críticos van en el
     nombre de cada operación y en la nota del centro de trabajo.
     Generado a partir de tablas de redacción; los datos son ficticios y verosímiles (supuesto S2 del plan). -->
<odoo noupdate="1">

    <!-- Centros de trabajo: capacidad y costo por hora supuestos -->
    <record id="wc_helados" model="mrp.workcenter">
        <field name="name">Línea Helados</field>
        <field name="code">LH</field>
        <field name="costs_hour">85.0</field>
        <field name="note" type="html"><p>Controles críticos (PCC supuestos): pasteurizar a 80-85 °C; madurar a 2-6 °C; endurecer a -18 °C o menos.</p></field>
    </record>
    <record id="wc_chocolates" model="mrp.workcenter">
        <field name="name">Línea Chocolates</field>
        <field name="code">LC</field>
        <field name="costs_hour">70.0</field>
        <field name="note" type="html"><p>Controles críticos (supuestos): conchado a 50-60 °C; templado a 31-32 °C; moldeo y enfriado a 12-15 °C.</p></field>
    </record>
    <record id="wc_paneton" model="mrp.workcenter">
        <field name="name">Línea Panetón</field>
        <field name="code">LP</field>
        <field name="costs_hour">60.0</field>
        <field name="note" type="html"><p>Controles críticos (supuestos): fermentación a 28-30 °C por 8 h; horneado a 170-180 °C; enfriar hasta 25 °C antes de empacar.</p></field>
