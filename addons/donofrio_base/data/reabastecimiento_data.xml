<?xml version="1.0" encoding="utf-8"?>
<!-- HU-13: reabastecimiento mínimo/máximo de los insumos en la Planta Lima (03 §3.3 e).
     Cuando las existencias previstas bajan del mínimo, el planificador genera la solicitud de cotización (RFQ)
     al proveedor del insumo por lo que falta para llegar al máximo; al confirmar la orden de compra se crea la
     recepción. Los números salen de las recetas y del plan semanal de producción (scripts/cargar_transacciones.py):
       mínimo = consumo de (plazo del proveedor + 7 días de seguridad)
       máximo = mínimo + 2 semanas de consumo (el ciclo de pedido)
     Son supuestos ficticios. -->
<odoo noupdate="1">

    <!-- El planificador arma cada compra con el comprador del proveedor (``res.partner.buyer_id``): se asigna al
         usuario Comprador. Es una función y no un campo de los registros del proveedor porque esos son ``noupdate``. -->
    <function model="res.partner" name="write"
              eval="([ref('prov_lacteos'), ref('prov_cacao'), ref('prov_molino'), ref('prov_frutas'), ref('prov_envases'), ref('prov_cartones')], {'buyer_id': ref('user_compras')})"/>

    <record id="rp_leche" model="stock.warehouse.orderpoint">
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="location_id" model="stock.warehouse" eval="obj(ref('stock.warehouse0')).lot_stock_id.id"/>
        <field name="product_id" model="product.template" eval="obj(ref('in_leche')).product_variant_id.id"/>
        <field name="route_id" ref="purchase_stock.route_warehouse0_buy"/>
        <field name="trigger">auto</field>
        <field name="product_min_qty">21000</field>
        <field name="product_max_qty">53000</field>
    </record>

