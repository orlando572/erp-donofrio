    <record id="dep_despacho" model="hr.department">
        <field name="name">Despacho</field>
        <field name="parent_id" ref="dep_logistica"/>
        <field name="color" eval="3"/>
    </record>

    <record id="dep_produccion" model="hr.department">
        <field name="name">Producción y Operaciones</field>
        <field name="parent_id" ref="dep_gerencia"/>
        <field name="color" eval="10"/>
    </record>

    <record id="dep_linea_helados" model="hr.department">
        <field name="name">Línea Helados</field>
        <field name="parent_id" ref="dep_produccion"/>
        <field name="color" eval="10"/>
    </record>

    <record id="dep_linea_chocolates" model="hr.department">
        <field name="name">Línea Chocolates</field>
        <field name="parent_id" ref="dep_produccion"/>
        <field name="color" eval="10"/>
