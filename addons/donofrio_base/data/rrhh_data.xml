    <record id="emp_comprador" model="hr.employee">
        <field name="name">Héctor Palomino Ruiz</field>
        <field name="job_id" ref="job_comprador"/>
        <field name="department_id" ref="dep_compras"/>
        <field name="parent_id" ref="emp_gerente"/>
        <field name="user_id" ref="user_compras"/>
    </record>

    <record id="emp_contador" model="hr.employee">
        <field name="name">Marisol Chávez Torres</field>
        <field name="job_id" ref="job_contador"/>
        <field name="department_id" ref="dep_finanzas"/>
        <field name="parent_id" ref="emp_gerente"/>
