<?xml version="1.0" encoding="utf-8"?>
<!-- HU-05 (RF017): organigrama (01 §1.5), puestos y empleados de D'Onofrio en RR. HH.
     Los departamentos forman la jerarquía con parent_id; hr_org_chart la muestra como organigrama.
     Los 21 empleados son ficticios. Diez de ellos están vinculados a los usuarios por rol de HU-04
     (usuarios_data.xml). Los heladeros NO son empleados: se modelan como contactos-concesionarios (Fase 2).
     En Odoo 19 el departamento, el puesto y el jefe del empleado viven en su hr.version vigente;
     al crear el empleado se escriben directamente y Odoo los pasa a la versión. -->
<odoo>
<data noupdate="1">

    <!-- Departamentos (jerarquía del organigrama) -->
    <record id="dep_gerencia" model="hr.department">
        <field name="name">Gerencia General</field>
        <field name="color" eval="5"/>
    </record>

    <record id="dep_ventas" model="hr.department">
        <field name="name">Marketing y Ventas</field>
        <field name="parent_id" ref="dep_gerencia"/>
        <field name="color" eval="9"/>
    </record>

    <record id="dep_canal_moderno" model="hr.department">
        <field name="name">Canal Moderno</field>
        <field name="parent_id" ref="dep_ventas"/>
        <field name="color" eval="9"/>
    </record>

    <record id="dep_canal_tradicional" model="hr.department">
        <field name="name">Canal Tradicional</field>
        <field name="parent_id" ref="dep_ventas"/>
        <field name="color" eval="9"/>
    </record>

    <record id="dep_heladeros" model="hr.department">
        <field name="name">Heladeros (rutas y liquidación)</field>
        <field name="parent_id" ref="dep_ventas"/>
        <field name="color" eval="9"/>
    </record>

    <record id="dep_logistica" model="hr.department">
        <field name="name">Logística y Distribución</field>
        <field name="parent_id" ref="dep_gerencia"/>
        <field name="color" eval="3"/>
    </record>

    <record id="dep_alm_lima" model="hr.department">
