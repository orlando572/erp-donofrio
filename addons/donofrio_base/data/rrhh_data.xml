</data>

<!-- Jefes de departamento. Van aparte, con noupdate="0": Odoo ignora al actualizar (-u) los registros y las
     funciones de un bloque noupdate="1", y aquí el resultado debe ser el mismo al instalar y al actualizar.
     Si el departamento ya tiene jefe, solo reasigna a los empleados que no tenían jefe. -->
<data noupdate="0">
    <function model="hr.department" name="write">
        <value eval="[ref('dep_gerencia')]"/>
        <value eval="{'manager_id': ref('emp_gerente')}"/>
    </function>
    <function model="hr.department" name="write">
        <value eval="[ref('dep_ventas')]"/>
        <value eval="{'manager_id': ref('emp_jefe_ventas')}"/>
    </function>
    <function model="hr.department" name="write">
        <value eval="[ref('dep_heladeros')]"/>
        <value eval="{'manager_id': ref('emp_sup_heladeros')}"/>
    </function>
    <function model="hr.department" name="write">
        <value eval="[ref('dep_logistica')]"/>
        <value eval="{'manager_id': ref('emp_jefe_almacen')}"/>
    </function>
    <function model="hr.department" name="write">
        <value eval="[ref('dep_alm_lima')]"/>
        <value eval="{'manager_id': ref('emp_enc_lima')}"/>
    </function>
    <function model="hr.department" name="write">
        <value eval="[ref('dep_cd_arequipa')]"/>
        <value eval="{'manager_id': ref('emp_enc_aqp')}"/>
    </function>
    <function model="hr.department" name="write">
        <value eval="[ref('dep_despacho')]"/>
        <value eval="{'manager_id': ref('emp_despacho')}"/>
    </function>
    <function model="hr.department" name="write">
        <value eval="[ref('dep_produccion')]"/>
        <value eval="{'manager_id': ref('emp_jefe_produccion')}"/>
    </function>
    <function model="hr.department" name="write">
        <value eval="[ref('dep_compras')]"/>
        <value eval="{'manager_id': ref('emp_comprador')}"/>
    </function>
    <function model="hr.department" name="write">
        <value eval="[ref('dep_finanzas')]"/>
        <value eval="{'manager_id': ref('emp_contador')}"/>
    </function>
    <function model="hr.department" name="write">
        <value eval="[ref('dep_rrhh')]"/>
        <value eval="{'manager_id': ref('emp_jefe_rrhh')}"/>
    </function>
    <function model="hr.department" name="write">
        <value eval="[ref('dep_ti')]"/>
        <value eval="{'manager_id': ref('emp_analista_ti')}"/>
    </function>

</data>
</odoo>
