    <record id="dep_linea_paneton" model="hr.department">
        <field name="name">Línea Panetón</field>
        <field name="parent_id" ref="dep_produccion"/>
        <field name="color" eval="10"/>
    </record>

    <record id="dep_calidad" model="hr.department">
        <field name="name">Aseguramiento de Calidad</field>
        <field name="parent_id" ref="dep_produccion"/>
        <field name="color" eval="10"/>
    </record>

    <record id="dep_compras" model="hr.department">
        <field name="name">Compras</field>
        <field name="parent_id" ref="dep_gerencia"/>
        <field name="color" eval="2"/>
