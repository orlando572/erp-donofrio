    <!-- Lotes con vencimiento y operaciones de producción visibles para los usuarios internos -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[
            Command.link(ref('stock.group_production_lot')),
            Command.link(ref('mrp.group_mrp_routings')),
        ]"/>
    </record>

