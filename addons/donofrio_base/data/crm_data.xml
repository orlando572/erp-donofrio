<?xml version="1.0" encoding="utf-8"?>
<!-- HU-08: embudo CRM por canal (03 §3.3 a). Equipos, etapas, etiquetas y 20 oportunidades ficticias.
     Las oportunidades llevan empresa y contacto como texto: los clientes reales se cargan aparte. -->
<odoo noupdate="1">

    <!-- Etapas del embudo. Se reemplazan las 4 de Odoo (New, Qualified, Proposition, Won) por las de D'Onofrio -->
    <delete model="crm.stage" search="[('id', 'in', [ref('crm.stage_lead1'), ref('crm.stage_lead2'), ref('crm.stage_lead3'), ref('crm.stage_lead4')])]"/>
    <record id="etapa_prospecto" model="crm.stage">
        <field name="name">Prospecto</field>
        <field name="sequence">1</field>
    </record>
    <record id="etapa_calificado" model="crm.stage">
        <field name="name">Calificado</field>
        <field name="sequence">2</field>
    </record>
    <record id="etapa_propuesta" model="crm.stage">
        <field name="name">Propuesta</field>
        <field name="sequence">3</field>
    </record>
    <record id="etapa_negociacion" model="crm.stage">
        <field name="name">Negociación</field>
        <field name="sequence">4</field>
    </record>
    <record id="etapa_ganado" model="crm.stage">
        <field name="name">Ganado</field>
        <field name="sequence">5</field>
        <field name="is_won" eval="True"/>
    </record>

    <!-- Equipos de venta por canal -->
    <record id="equipo_moderno" model="crm.team">
        <field name="name">Canal Moderno</field>
        <field name="user_id" ref="user_jefe_ventas"/>
        <field name="use_opportunities" eval="True"/>
    </record>
    <record id="equipo_tradicional" model="crm.team">
        <field name="name">Canal Tradicional</field>
        <field name="user_id" ref="user_vendedor"/>
        <field name="use_opportunities" eval="True"/>
    </record>
    <record id="equipo_heladeros" model="crm.team">
        <field name="name">Heladeros</field>
        <field name="user_id" ref="user_jefe_ventas"/>
        <field name="use_opportunities" eval="True"/>
    </record>

    <!-- Etiquetas por tipo de cliente -->
