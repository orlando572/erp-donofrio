<?xml version="1.0" encoding="utf-8"?>
<!-- HU-04: grupo y regla de registro del CD Arequipa (ISO 27001 5.15, 5.18, 8.3: mínimo privilegio).
     La regla solo afecta a los usuarios del grupo: quien no esté en él no tiene regla de grupo y ve todo
     lo que sus permisos estándar le dejan ver. -->
<odoo>

    <record id="res_groups_privilege_donofrio" model="res.groups.privilege">
        <field name="name">D'Onofrio</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_cd_arequipa" model="res.groups">
        <field name="name">Solo operaciones del CD Arequipa</field>
        <field name="sequence">90</field>
        <field name="privilege_id" ref="res_groups_privilege_donofrio"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Limita las operaciones de inventario (transferencias, movimientos y existencias) a las del almacén WH-AQP CD Arequipa.</field>
    </record>

    <!-- Transferencias cuyo origen o destino está en el almacén de Arequipa -->
    <record id="rule_picking_cd_arequipa" model="ir.rule">
        <field name="name">Transferencias: solo las del CD Arequipa</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="groups" eval="[Command.link(ref('group_cd_arequipa'))]"/>
        <field name="domain_force" eval="['|', ('location_id.warehouse_id', '=', ref('wh_aqp')), ('location_dest_id.warehouse_id', '=', ref('wh_aqp'))]"/>
    </record>

    <record id="rule_move_cd_arequipa" model="ir.rule">
        <field name="name">Movimientos de stock: solo los del CD Arequipa</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="groups" eval="[Command.link(ref('group_cd_arequipa'))]"/>
        <field name="domain_force" eval="['|', ('location_id.warehouse_id', '=', ref('wh_aqp')), ('location_dest_id.warehouse_id', '=', ref('wh_aqp'))]"/>
    </record>

    <record id="rule_move_line_cd_arequipa" model="ir.rule">
        <field name="name">Detalle de movimientos: solo los del CD Arequipa</field>
        <field name="model_id" ref="stock.model_stock_move_line"/>
        <field name="groups" eval="[Command.link(ref('group_cd_arequipa'))]"/>
        <field name="domain_force" eval="['|', ('location_id.warehouse_id', '=', ref('wh_aqp')), ('location_dest_id.warehouse_id', '=', ref('wh_aqp'))]"/>
    </record>

    <record id="rule_quant_cd_arequipa" model="ir.rule">
        <field name="name">Existencias: solo las del CD Arequipa</field>
        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="groups" eval="[Command.link(ref('group_cd_arequipa'))]"/>
        <field name="domain_force" eval="[('location_id.warehouse_id', '=', ref('wh_aqp'))]"/>
    </record>

</odoo>
