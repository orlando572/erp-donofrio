<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_calidad_inspector" model="res.groups">
        <field name="name">Calidad: inspector</field>
        <field name="sequence">80</field>
        <field name="privilege_id" ref="donofrio_base.res_groups_privilege_donofrio"/>
        <field name="implied_ids" eval="[Command.link(ref('stock.group_stock_user')), Command.link(ref('mrp.group_mrp_user'))]"/>
        <field name="comment">Mide los puntos de control, aprueba o rechaza lotes.</field>
    </record>

    <record id="group_calidad_jefe" model="res.groups">
        <field name="name">Calidad: jefatura</field>
        <field name="sequence">81</field>
        <field name="privilege_id" ref="donofrio_base.res_groups_privilege_donofrio"/>
        <field name="implied_ids" eval="[Command.link(ref('group_calidad_inspector'))]"/>
        <field name="comment">Además del inspector, define los puntos de control y borra inspecciones.</field>
    </record>
</odoo>
