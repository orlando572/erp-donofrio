<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_calidad_inspeccion_list" model="ir.ui.view">
        <field name="name">donofrio.calidad.inspeccion.list</field>
        <field name="model">donofrio.calidad.inspeccion</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'rechazada'" decoration-success="state == 'aprobada'">
                <field name="name"/>
                <field name="production_id"/>
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="inspector_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_calidad_inspeccion_form" model="ir.ui.view">
        <field name="name">donofrio.calidad.inspeccion.form</field>
        <field name="model">donofrio.calidad.inspeccion</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_iniciar" string="Iniciar medición" type="object" class="btn-primary"
                            invisible="state != 'borrador'"/>
                    <button name="action_aprobar" string="Aprobar lote" type="object" class="btn-primary"
                            invisible="state != 'en_curso'"/>
                    <button name="action_rechazar" string="Rechazar lote" type="object"
                            invisible="state != 'en_curso'"/>
 <button name="action_imprimir_certificado" string="Certificado PDF" type="object"
                            invisible="state != 'aprobada'"/>
                    <field name="state" widget="statusbar" statusbar_visible="borrador,en_curso,aprobada"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="production_id" readonly="state != 'borrador'"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="lot_id" readonly="state != 'borrador'"/>
                            <field name="inspector_id" readonly="state in ('aprobada', 'rechazada')"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="todos_cumplen" invisible="1"/>
                    <field name="linea_ids" readonly="state not in ('en_curso',)">
                        <list editable="bottom" create="0" delete="0"
                              decoration-success="resultado == 'cumple'" decoration-danger="resultado == 'no_cumple'">
                            <field name="punto_id" readonly="1"/>
                            <field name="tipo" column_invisible="1"/>
                            <field name="norma"/>
                            <field name="medicion" readonly="tipo == 'aprobacion'"/>
                            <field name="cumple_manual" readonly="tipo != 'aprobacion'"/>
                            <field name="resultado" widget="badge"/>
                        </list>
                    </field>
                    <group invisible="state not in ('en_curso', 'rechazada')">
                        <field name="motivo_rechazo" readonly="state == 'rechazada'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_calidad_inspeccion_search" model="ir.ui.view">
        <field name="name">donofrio.calidad.inspeccion.search</field>
        <field name="model">donofrio.calidad.inspeccion</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="lot_id"/>
                <field name="production_id"/>
                <filter name="pendientes" string="Por medir" domain="[('state', 'in', ('borrador', 'en_curso'))]"/>
                <filter name="rechazadas" string="Rechazadas" domain="[('state', '=', 'rechazada')]"/>
                <group>
                    <filter name="por_estado" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_calidad_inspeccion" model="ir.actions.act_window">
        <field name="name">Inspecciones</field>
        <field name="res_model">donofrio.calidad.inspeccion</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pendientes': 1}</field>
    </record>

    <record id="view_calidad_punto_list" model="ir.ui.view">
        <field name="name">donofrio.calidad.punto.list</field>
        <field name="model">donofrio.calidad.punto</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="categ_id"/>
                <field name="tipo"/>
                <field name="valor_min" readonly="tipo == 'aprobacion'"/>
                <field name="valor_max" readonly="tipo == 'aprobacion'"/>
                <field name="unidad"/>
            </list>
        </field>
    </record>

    <record id="action_calidad_punto" model="ir.actions.act_window">
        <field name="name">Puntos de control</field>
        <field name="res_model">donofrio.calidad.punto</field>
        <field name="view_mode">list</field>
    </record>

    <!-- HU-19: cadena de frío (RF008, CU006) -->
    <record id="view_stock_location_form_temperatura" model="ir.ui.view">
        <field name="name">stock.location.form.temperatura</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='removal_strategy_id']/parent::group" position="after">
                <group string="Cadena de frío" name="cadena_frio" invisible="usage != 'internal'">
                    <field name="control_temperatura"/>
                    <field name="temp_min" invisible="not control_temperatura"/>
                    <field name="temp_max" invisible="not control_temperatura"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_temperatura_list" model="ir.ui.view">
        <field name="name">donofrio.temperatura.list</field>
        <field name="model">donofrio.temperatura</field>
        <field name="arch" type="xml">
            <list decoration-danger="fuera_de_rango">
                <field name="fecha"/>
                <field name="location_id"/>
                <field name="temperatura"/>
                <field name="rango"/>
                <field name="fuera_de_rango" widget="boolean"/>
                <field name="user_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="view_temperatura_form" model="ir.ui.view">
        <field name="name">donofrio.temperatura.form</field>
        <field name="model">donofrio.temperatura</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Fuera de rango" bg_color="text-bg-danger" invisible="not fuera_de_rango"/>
                    <group>
                        <group>
                            <field name="location_id" options="{'no_create': True}"/>
                            <field name="temperatura"/>
                            <field name="rango"/>
                            <field name="fuera_de_rango"/>
                        </group>
                        <group>
                            <field name="fecha"/>
                            <field name="user_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="observaciones" placeholder="Observaciones (opcional)"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_temperatura_search" model="ir.ui.view">
        <field name="name">donofrio.temperatura.search</field>
        <field name="model">donofrio.temperatura</field>
        <field name="arch" type="xml">
            <search>
                <field name="location_id"/>
                <field name="user_id"/>
                <filter name="fuera_de_rango" string="Fuera de rango" domain="[('fuera_de_rango', '=', True)]"/>
                <filter name="en_rango" string="En rango" domain="[('fuera_de_rango', '=', False)]"/>
                <separator/>
                <filter name="hoy" string="Hoy" domain="[('fecha', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="fecha" string="Fecha" date="fecha"/>
                <group>
                    <filter name="por_ubicacion" string="Ubicación" context="{'group_by': 'location_id'}"/>
                    <filter name="por_dia" string="Día" context="{'group_by': 'fecha:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_temperatura" model="ir.actions.act_window">
        <field name="name">Lecturas de temperatura</field>
        <field name="res_model">donofrio.temperatura</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre la primera lectura de temperatura</p>
            <p>Si la lectura sale del rango de la ubicación, se marca y el jefe de almacén recibe una actividad.</p>
        </field>
    </record>

    <menuitem id="menu_calidad_root" name="Calidad" sequence="45"
              groups="group_calidad_inspector,stock.group_stock_user"/>
    <menuitem id="menu_calidad_inspecciones" name="Inspecciones" parent="menu_calidad_root"
              action="action_calidad_inspeccion" sequence="10"/>
    <menuitem id="menu_calidad_puntos" name="Puntos de control" parent="menu_calidad_root"
              action="action_calidad_punto" sequence="20" groups="group_calidad_jefe"/>
    <menuitem id="menu_calidad_frio" name="Cadena de frío" parent="menu_calidad_root" sequence="30"/>
    <menuitem id="menu_calidad_temperaturas" name="Lecturas de temperatura" parent="menu_calidad_frio"
              action="action_temperatura" sequence="10"/>
</odoo>
