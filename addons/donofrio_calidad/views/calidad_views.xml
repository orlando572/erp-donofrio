<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_calidad_inspeccion_list" model="ir.ui.view">
        <field name="name">donofrio.calidad.inspeccion.list</field>
        <field name="model">donofrio.calidad.inspeccion</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'rechazada'" decoration-success="state == 'aprobada'">
                <field name="name"/>
                <field name="production_id"/>
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="inspector_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_calidad_inspeccion_form" model="ir.ui.view">
        <field name="name">donofrio.calidad.inspeccion.form</field>
        <field name="model">donofrio.calidad.inspeccion</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_iniciar" string="Iniciar medición" type="object" class="btn-primary"
                            invisible="state != 'borrador'"/>
                    <button name="action_aprobar" string="Aprobar lote" type="object" class="btn-primary"
                            invisible="state != 'en_curso'"/>
                    <button name="action_rechazar" string="Rechazar lote" type="object"
                            invisible="state != 'en_curso'"/>
 <button name="action_imprimir_certificado" string="Certificado PDF" type="object"
                            invisible="state != 'aprobada'"/>
                    <field name="state" widget="statusbar" statusbar_visible="borrador,en_curso,aprobada"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="production_id" readonly="state != 'borrador'"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="lot_id" readonly="state != 'borrador'"/>
                            <field name="inspector_id" readonly="state in ('aprobada', 'rechazada')"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="todos_cumplen" invisible="1"/>
                    <field name="linea_ids" readonly="state not in ('en_curso',)">
                        <list editable="bottom" create="0" delete="0"
                              decoration-success="resultado == 'cumple'" decoration-danger="resultado == 'no_cumple'">
                            <field name="punto_id" readonly="1"/>
                            <field name="tipo" column_invisible="1"/>
                            <field name="norma"/>
                            <field name="medicion" readonly="tipo == 'aprobacion'"/>
                            <field name="cumple_manual" readonly="tipo != 'aprobacion'"/>
                            <field name="resultado" widget="badge"/>
                        </list>
                    </field>
                    <group invisible="state not in ('en_curso', 'rechazada')">
                        <field name="motivo_rechazo" readonly="state == 'rechazada'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_calidad_inspeccion_search" model="ir.ui.view">
        <field name="name">donofrio.calidad.inspeccion.search</field>
        <field name="model">donofrio.calidad.inspeccion</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="lot_id"/>
                <field name="production_id"/>
                <filter name="pendientes" string="Por medir" domain="[('state', 'in', ('borrador', 'en_curso'))]"/>
                <filter name="rechazadas" string="Rechazadas" domain="[('state', '=', 'rechazada')]"/>
                <group>
                    <filter name="por_estado" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_calidad_inspeccion" model="ir.actions.act_window">
        <field name="name">Inspecciones</field>
        <field name="res_model">donofrio.calidad.inspeccion</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pendientes': 1}</field>
    </record>

    <record id="view_calidad_punto_list" model="ir.ui.view">
        <field name="name">donofrio.calidad.punto.list</field>
        <field name="model">donofrio.calidad.punto</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="categ_id"/>
                <field name="tipo"/>
                <field name="valor_min" readonly="tipo == 'aprobacion'"/>
                <field name="valor_max" readonly="tipo == 'aprobacion'"/>
                <field name="unidad"/>
            </list>
        </field>
    </record>

    <record id="action_calidad_punto" model="ir.actions.act_window">
        <field name="name">Puntos de control</field>
        <field name="res_model">donofrio.calidad.punto</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_calidad_root" name="Calidad" sequence="45"
              groups="group_calidad_inspector,stock.group_stock_user"/>
    <menuitem id="menu_calidad_inspecciones" name="Inspecciones" parent="menu_calidad_root"
              action="action_calidad_inspeccion" sequence="10"/>
    <menuitem id="menu_calidad_puntos" name="Puntos de control" parent="menu_calidad_root"
              action="action_calidad_punto" sequence="20" groups="group_calidad_jefe"/>
</odoo>
