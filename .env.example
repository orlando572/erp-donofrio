# Copia este archivo como .env (cp .env.example .env). .env NO se sube al repo.
# Estos valores son solo para desarrollo local; en un despliegue real se cambian
# (en GitHub Secrets y en el .env del servidor).

# Base de datos de Odoo (la crea scripts/init_db.sh)
ODOO_DB=donofrio

# Contraseña maestra de Odoo (admin_passwd)
ODOO_ADMIN_PASSWD=cambiar-admin-passwd

# PostgreSQL: superusuario interno y rol de Odoo (sin superusuario)
POSTGRES_PASSWORD=cambiar-postgres-passwd
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=cambiar-odoo-db-passwd

# Puertos publicados en localhost (cámbialos si ya están ocupados en tu PC)
ODOO_PORT=8069
ODOO_LONGPOLLING_PORT=8072
DB_PORT=5432
